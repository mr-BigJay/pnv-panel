# PNV Panel — Nginx + PHP-FPM (HTTP only; certbot --nginx adds HTTPS)
# Copy to /etc/nginx/sites-available/pnv-panel.conf
# Replace PNV_DOMAIN, PNV_ROOT, and PNV_PHP_FPM_SOCK before use.

server {
    listen 80;
    listen [::]:80;
    server_name PNV_DOMAIN;

    root PNV_ROOT;
    index index.php index.html;

    client_max_body_size 32m;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ^~ /bigjay_controller/ {
        try_files $uri $uri/ /bigjay_controller/index.php?$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:PNV_PHP_FPM_SOCK;
    }

    location ~* \.(css|js|png|jpg|jpeg|gif|webp|svg|woff|woff2)$ {
        expires 7d;
        access_log off;
    }

    location ~ /\. {
        deny all;
    }
}
