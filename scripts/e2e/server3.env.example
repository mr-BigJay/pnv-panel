# HOST must match exactly one server entry in xui_servers.json (vip / vip2 / vip3 / vip4)
export PNV_E2E_SUB_LINK='https://YOUR_VIP_HOST:2096/sub/YOUR_TEST_SUB_ID'
export PNV_E2E_ALLOWED_SUB_ID='YOUR_TEST_SUB_ID'
export PNV_E2E_ALLOWED_EMAIL='e2e_your_test_client@example.com'
export PNV_XUI_CONFIG_SOURCE='/var/www/html/db/xui_servers.json'
export PNV_E2E_WORKDIR='/tmp/pnv-e2e-renew-reserve'
export PNV_E2E_USERNAME='pnv_e2e_user'
export PNV_E2E_PLAN_GB='2'
export PNV_E2E_PLAN_DAYS='7'
